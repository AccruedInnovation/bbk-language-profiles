  "support": {
    "conditional": [
      "multiprocessing and process pools",
      "plugin and entry-point systems",
      "database migrations",
      "free-threaded CPython",
      "native extensions through CPython C API, Cython, cffi, ctypes, or PyO3/maturin",
      "public typing distributions and stub packages",
      "web and hypermedia applications"
    ],
    "partial_or_unqualified": [
      "scientific binary-wheel ecosystems with complex native stacks",
      "embedded Python",
      "mobile Python",
      "Python on WASM",
      "GPU-specific stacks",
      "alternative interpreters not declared and tested by the project",
      "operating-system vendor packaging"
    ],
    "primary": [
      "pure-Python libraries",
      "command-line applications",
      "ordinary applications and services",
      "pyproject.toml projects",
      "pytest or repository-defined test suites",
      "optional static typing",
      "asyncio applications",
      "sdist and wheel packaging"
