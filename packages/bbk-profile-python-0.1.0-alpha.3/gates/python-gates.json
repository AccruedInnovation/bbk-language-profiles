      "class": "required-when-triggered",
      "command": [
        "bbk-python",
        "slice",
        "--root",
        "{root}",
        "--slice",
        "{slice}",
        "--role",
        "reviewer",
        "--task-profile",
        "execution-slicing",
        "--assurance-tier",
        "{tier}"
