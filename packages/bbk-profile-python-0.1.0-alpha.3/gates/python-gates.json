      ],
      "class": "required-when-triggered",
      "command": [
        "{repository-migration-test-command}"
      ],
      "id": "python-migration-rollback",
      "minimum_tier": "consequential",
      "requires": [
        "repository-defined"
      ],
      "triggers": [
        "migration",
        "rollback",
        "persistence"
      ]
    },
    {
