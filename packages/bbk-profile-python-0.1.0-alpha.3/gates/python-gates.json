        "runtime-state",
        "asyncio",
        "multiprocessing",
        "persistence-migration"
      ]
    },
    {
      "assertions": [
        "Material divergence names an exact fixed decision, shared contract, owner, behavior path, effect boundary, assertion, or slice; harmless delegated private differences do not fail conformance"
      ],
      "class": "required-when-triggered",
      "command": [
        "bbk-python",
        "structure-review",
        "--root",
        "{root}",
        "--contract",
        "{contract}",
        "--candidate",
        "{candidate}",
        "--actual-inventory",
        "{actual-inventory}"
      ],
      "id": "python-planned-actual-structure-compare",
      "minimum_tier": "material",
      "requires": [
        "bbk-python"
      ],
      "triggers": [
        "planned-actual",
        "implementation-structure"
      ]
    },
    {
      "assertions": [
        "The execution slice has one real Python-appropriate integrated touchpoint, exact dependency closure, assertions, containment, and evidence plan"
      ],
      "class": "required-when-triggered",
      "command": [
        "bbk-python",
        "slice",
        "--root",
        "{root}",
        "--slice",
        "{slice}",
        "--role",
        "{role}",
        "--task-profile",
        "execution-slicing",
        "--assurance-tier",
        "{tier}"
