{
  "policy": {
    "check_only_final_gates": true,
    "full_suite_repeat": "Only when the assurance contract or aggregate gate requires it; do not repeat at every layer for reassurance.",
    "installed_artifact_for_release_claims": true,
    "missing_recommended_tool": "ADVISORY",
    "missing_required_tool": "BLOCKED",
    "no_environment_creation": true,
    "no_silent_install": true,
    "planned_actual_comparison_is_candidate_bound": true,
    "profile_projection_is_not_conformance_evidence": true,
    "repository_commands_first": true,
    "structure_resolution_does_not_execute_gates": true
  },
  "recipes": [
    {
      "assertions": [
        "Changed Python sources parse and compile in memory without writing bytecode"
      ],
      "class": "always-cheap",
      "command": [
        "bbk-python",
        "syntax-check",
        "--root",
        "{root}",
        "--path",
        "{scope}"
      ],
      "id": "python-syntax-check",
      "minimum_tier": "routine",
      "requires": [
        "bbk-python"
      ]
    },
    {
      "assertions": [
        "Python formatting matches repository policy"
      ],
      "class": "required-if-configured",
      "command": [
        "{repository-format-command}"
      ],
      "id": "python-format-check",
      "minimum_tier": "routine",
      "requires": [
        "repository-defined"
      ]
    },
    {
      "assertions": [
        "Repository-authoritative Python lints pass"
      ],
      "class": "required-if-configured",
      "command": [
        "{repository-lint-command}"
      ],
      "id": "python-lint-check",
      "minimum_tier": "routine",
      "requires": [
        "repository-defined"
      ]
    },
    {
      "assertions": [
        "Focused tests covering the changed behavior pass"
      ],
      "class": "required-if-configured",
      "command": [
        "{repository-focused-test-command}"
      ],
      "id": "python-focused-tests",
      "minimum_tier": "routine",
      "requires": [
        "repository-defined"
      ]
    },
    {
      "assertions": [
        "Configured static typing assertions pass for the affected scope"
      ],
      "class": "required-if-configured",
      "command": [
        "{repository-type-check-command}"
      ],
      "id": "python-type-check-affected",
      "limitations": [
        "Type-checker success does not establish runtime validation or behavior"
      ],
      "minimum_tier": "routine",
      "requires": [
        "repository-defined"
      ],
      "triggers": [
        "typing",
        "typing-api",
        "public-api"
      ]
    },
    {
      "assertions": [
        "The declared build backend produces the required distribution artifacts in isolation"
      ],
      "class": "required-when-triggered",
      "command": [
        "{repository-build-command}"
      ],
      "id": "python-build-distributions",
      "minimum_tier": "material",
      "requires": [
        "repository-defined-or-python-build"
      ],
      "triggers": [
        "distribution",
        "package",
        "release"
      ]
    },
    {
      "assertions": [
        "The clean installed wheel behaves correctly outside the source checkout"
