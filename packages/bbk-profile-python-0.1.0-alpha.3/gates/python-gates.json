      "class": "required-when-triggered",
      "command": [
        "{repository-installed-wheel-test-command}"
      ],
      "id": "python-installed-wheel-tests",
      "minimum_tier": "material",
      "requires": [
        "repository-defined"
      ],
      "triggers": [
        "distribution",
        "package",
        "public-api",
        "entry-point"
      ]
    },
