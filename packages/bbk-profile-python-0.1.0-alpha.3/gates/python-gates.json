        "startup",
        "shutdown",
        "deployment"
      ]
    },
    {
      "assertions": [
        "The generic ImplementationStructureContract is schema-valid and bound to an exact identity and digest"
      ],
      "class": "required-when-triggered",
      "command": [
        "bbk",
        "structure",
        "validate",
        "--contract",
        "{contract}"
      ],
      "id": "python-generic-structure-contract-validate",
      "minimum_tier": "routine",
      "requires": [
        "bbk-alpha4-structure-validator"
      ],
      "triggers": [
        "implementation-structure"
      ]
    },
    {
      "assertions": [
        "The deterministic Python projection is schema-valid and preserves generic identity, fixed decisions, delegated freedom, scope, and authority"
      ],
      "class": "required-when-triggered",
      "command": [
        "bbk-python",
        "structure",
        "--root",
        "{root}",
        "--contract",
        "{contract}",
        "--role",
        "{role}",
        "--task-profile",
        "implementation-structure",
        "--assurance-tier",
        "{tier}"
      ],
      "id": "python-structure-projection-validate",
      "minimum_tier": "routine",
      "requires": [
        "bbk-python"
      ],
      "triggers": [
        "implementation-structure"
      ]
    },
    {
      "assertions": [
        "Public runtime imports, public typing surfaces, entry points, package subjects, and shared runtime schemas do not materially diverge from fixed contract decisions"
      ],
      "class": "required-when-triggered",
      "command": [
        "bbk-python",
        "structure-review",
        "--root",
        "{root}",
        "--contract",
        "{contract}",
        "--candidate",
        "{candidate}"
      ],
      "id": "python-public-shared-contract-drift",
      "minimum_tier": "material",
      "requires": [
        "bbk-python"
      ],
      "triggers": [
        "public-api",
        "typing-api",
        "distribution",
        "entry-point-plugin"
      ]
    },
    {
      "assertions": [
        "State, resource, task, process, transaction, cancellation, cleanup, retry, and recovery ownership remain consistent with fixed decisions"
      ],
      "class": "required-when-triggered",
      "command": [
        "bbk-python",
        "structure-review",
        "--root",
        "{root}",
        "--contract",
        "{contract}",
        "--candidate",
        "{candidate}"
      ],
      "id": "python-state-ownership-drift",
      "minimum_tier": "material",
      "requires": [
        "bbk-python"
      ],
      "triggers": [
