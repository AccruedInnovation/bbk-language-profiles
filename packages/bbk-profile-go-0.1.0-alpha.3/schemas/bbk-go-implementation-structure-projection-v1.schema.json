{
  "$id": "https://bbk.local/schemas/bbk-go-implementation-structure-projection-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "advisories": {
      "type": "array"
    },
    "applicability": {
      "additionalProperties": true,
      "properties": {
        "disposition": {
          "enum": [
            "SUPPORTED",
            "PARTIAL",
            "UNSUPPORTED",
            "NOT_APPLICABLE",
            "BLOCKED"
          ]
        },
        "level": {
          "enum": [
            "none",
            "inline",
            "contract"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "triggers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "level",
        "disposition",
        "rationale"
      ],
      "type": "object"
    },
    "assurance_tier": {
      "enum": [
        "routine",
        "material",
        "consequential",
        "critical"
      ]
    },
    "authority_boundary": {
      "additionalProperties": true,
      "properties": {
        "may_declare_pass": {
          "const": false
        },
        "may_expand_work_scope": {
          "const": false
        },
        "may_grant_tools_or_effects": {
          "const": false
        },
        "may_reduce_assurance": {
          "const": false
        }
      },
      "required": [
        "may_declare_pass",
        "may_expand_work_scope",
        "may_grant_tools_or_effects",
        "may_reduce_assurance"
      ],
      "type": "object"
    },
    "bbk_version": {
      "type": "string"
    },
    "blockers": {
      "type": "array"
    },
    "input": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "revision",
        "sha256"
      ],
      "type": "object"
    },
    "output_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "preflight_sha256": {
      "oneOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "profile": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "const": "go"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "projection": {
      "type": "object"
    },
    "review_selection": {
      "type": "object"
    },
    "role": {
      "type": "string"
    },
    "schema": {
      "const": "bbk.go.implementation-structure-projection.v1"
    },
    "task_profile": {
      "type": "string"
    },
    "unsupported_or_uncertain": {
      "type": "array"
    }
  },
  "required": [
    "schema",
    "profile",
    "bbk_version",
    "input",
    "applicability",
    "unsupported_or_uncertain",
    "advisories",
    "blockers",
    "authority_boundary",
    "output_sha256",
    "role",
    "task_profile",
    "assurance_tier",
    "projection",
    "review_selection"
  ],
  "title": "BBK Go implementation structure projection v1",
  "type": "object"
}
