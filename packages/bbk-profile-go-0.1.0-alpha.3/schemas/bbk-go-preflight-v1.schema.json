{
  "$id": "https://bbk.local/schemas/bbk-go-preflight-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "configuration": {
      "type": "object"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "modules": {
      "type": "array"
    },
    "root": {
      "type": "string"
    },
    "schema": {
      "const": "bbk.go-preflight.v1"
    },
    "toolchain": {
      "type": "object"
    },
    "workspace": {
      "type": "object"
    }
  },
  "required": [
    "schema",
    "profile",
    "root",
    "workspace",
    "modules",
    "toolchain",
    "configuration",
    "digest"
  ],
  "title": "BBK Go preflight",
  "type": "object"
}
