{
  "scan": {
    "exclude_globs": [
      "target/**",
      ".git/**",
      ".jj/**",
      ".bbk/**",
      ".bbk-worktrees/**",
      "vendor/**"
    ],
    "max_file_bytes": 1048576,
    "max_files": 5000,
    "source_extensions": [
      ".rs",
      ".toml",
      ".lock",
      ".json",
      ".yaml",
      ".yml",
      ".proto",
      ".wit",
      ".sql"
    ]
  },
  "schema": "bbk.rust-risk-trigger-map.v1",
  "triggers": [
    {
      "change_classes": [
        "interface",
        "schema"
      ],
      "content_regex": [
        "\\bpub\\s+(fn|struct|enum|trait|type|mod|use|const|static)\\b",
        "#\\s*\\[\\s*non_exhaustive\\s*\\]"
      ],
      "file_globs": [
        "**/lib.rs",
        "**/Cargo.toml"
      ],
      "gate_tags": [
        "api",
        "compatibility"
      ],
      "hints": [
        "public-api",
        "semver",
        "crate-boundary",
        "re-export",
        "downstream-caller"
      ],
      "id": "public-api",
      "select": [
        "rust-api-crate-boundary-review"
      ]
    },
    {
      "change_classes": [
        "schema",
        "migration",
        "interface"
      ],
      "content_regex": [
        "serde(::|\\s*\\()",
        "#\\s*\\[\\s*serde",
        "prost::",
        "bincode",
        "rmp_serde",
        "postcard"
      ],
      "file_globs": [
        "**/*.proto",
        "**/*.wit",
        "**/schema/**",
        "**/migrations/**"
      ],
      "gate_tags": [
        "wire",
        "compatibility",
        "migration"
      ],
      "hints": [
        "wire-format",
        "serde-wire-format",
        "serialization",
        "protocol",
        "schema-evolution"
      ],
      "id": "wire-serialization",
      "select": [
        "rust-api-crate-boundary-review",
        "rust-correctness-failure-review"
      ]
    },
    {
      "change_classes": [
        "implementation",
        "interface"
      ],
      "content_regex": [
        "\\basync\\s+fn\\b",
        "\\.await\\b",
        "tokio::",
        "std::sync::(Mutex|RwLock|Arc)",
        "Atomic[A-Za-z0-9_]*",
        "spawn(_blocking)?\\s*\\("
      ],
      "gate_tags": [
        "async",
        "concurrency",
        "cancellation"
      ],
      "hints": [
        "async",
        "concurrency",
        "cancellation",
        "retry",
        "ordering",
        "shared-state"
      ],
      "id": "async-concurrency",
      "select": [
        "rust-correctness-failure-review"
      ]
    },
    {
      "change_classes": [
        "migration",
        "persistence",
        "implementation"
      ],
      "content_regex": [
        "sqlx::",
        "diesel::",
        "rusqlite::",
        "transaction\\s*\\(",
        "fs::(write|rename|remove|create)",
        "OpenOptions"
      ],
      "file_globs": [
        "**/migrations/**",
        "**/*.sql"
      ],
      "gate_tags": [
        "persistence",
        "recovery",
        "fault"
      ],
      "hints": [
        "persistence",
        "transaction",
        "migration",
        "recovery",
        "idempotency",
        "durability"
      ],
      "id": "persistence-state",
      "select": [
        "rust-correctness-failure-review",
        "rust-test-strategy-review"
      ]
    },
    {
      "change_classes": [
        "interface",
        "implementation",
        "dependency"
      ],
      "content_regex": [
        "\\bunsafe\\b",
        "extern\\s+\\\"",
        "repr\\s*\\(\\s*(C|transparent|packed)",
        "MaybeUninit",
        "ManuallyDrop",
        "unsafe\\s+impl\\s+(Send|Sync)",
        "#\\s*\\[\\s*unsafe\\s*\\(\\s*(no_mangle|export_name|link_section)"
      ],
      "file_globs": [
        "**/build.rs",
        "**/*bindgen*",
        "**/*cbindgen*"
      ],
      "gate_tags": [
        "unsafe",
        "ffi",
        "abi",
        "miri"
      ],
      "hints": [
        "unsafe",
        "ffi",
        "abi",
        "raw-pointer",
        "manual-send-sync",
        "native-library",
        "bindgen",
        "cbindgen"
      ],
      "id": "unsafe-ffi",
      "select": [
        "rust-unsafe-ffi-assurance",
        "rust-correctness-failure-review",
        "rust-security-supply-chain-review"
      ]
    },
    {
      "change_classes": [
        "dependency",
        "security",
        "packaging"
      ],
      "content_regex": [
        "std::process::Command",
        "tokio::process::Command",
        "reqwest::",
        "hyper::",
        "Tcp(Stream|Listener)",
        "UdpSocket",
        "libloading::",
        "include_(bytes|str)!"
      ],
      "file_globs": [
        "**/Cargo.lock",
        "**/Cargo.toml",
        "**/build.rs",
        "**/.cargo/config.toml",
        "**/.cargo/config"
      ],
      "gate_tags": [
        "security",
        "dependencies",
        "supply-chain"
      ],
      "hints": [
        "security",
        "supply-chain",
        "dependency",
        "secrets",
        "untrusted-input",
        "filesystem",
        "command",
        "network",
        "plugin"
      ],
      "id": "security-supply-chain",
      "select": [
        "rust-security-supply-chain-review"
      ]
    },
    {
      "change_classes": [
        "test",
        "verification"
      ],
      "content_regex": [
        "cargo\\s+mutest",
        "mutest-rs"
      ],
      "file_globs": [
        "**/mutest.toml",
        "**/.config/mutest/**"
      ],
      "gate_tags": [
        "mutation-testing",
        "mutest-rs"
      ],
      "hints": [
        "mutation-testing",
        "mutest-rs",
        "mutation-analysis"
      ],
      "id": "mutation-testing",
      "select": [
        "rust-test-strategy-review",
        "rust-evidence-reproducer"
      ]
    },
    {
      "change_classes": [
        "test",
        "verification"
      ],
      "content_regex": [
        "#\\s*\\[\\s*(test|tokio::test|proptest)",
        "proptest!",
        "loom::",
        "criterion::"
      ],
      "file_globs": [
        "**/tests/**",
        "**/benches/**",
        "**/fuzz/**"
      ],
      "gate_tags": [
        "test",
        "property",
        "fuzz"
      ],
      "hints": [
        "test-strategy",
        "regression",
        "property-test",
        "fuzz",
        "loom",
        "coverage"
      ],
      "id": "test-strategy",
      "select": [
        "rust-test-strategy-review",
        "rust-evidence-reproducer"
      ]
    },
    {
      "change_classes": [
        "packaging",
        "release",
        "migration"
      ],
      "content_regex": [
        "tracing::",
        "metrics::",
        "clap::",
        "config::",
        "dotenv",
        "signal::",
        "ctrl_c"
      ],
      "file_globs": [
        "**/Dockerfile*",
        "**/dist/**",
        "**/packaging/**",
        "**/.github/workflows/**",
        "**/deny.toml"
      ],
      "gate_tags": [
        "release",
        "package",
        "operations"
      ],
      "hints": [
        "operations",
        "deployment",
        "release",
        "package",
        "rollback",
        "observability",
        "configuration"
      ],
      "id": "operations-release",
      "select": [
        "rust-operational-readiness-review",
        "rust-package-release-gates"
      ]
    },
    {
      "change_classes": [
        "architecture"
      ],
      "gate_tags": [],
      "hints": [
        "broad-analysis",
        "whole-codebase",
        "architecture-review",
        "modernization",
        "inherited-codebase"
      ],
      "id": "broad-architecture",
      "select": [
        "comprehensive-analysis-rust"
      ]
    },
    {
      "change_classes": [
        "performance"
      ],
      "content_regex": [
        "criterion::",
        "black_box\\s*\\(",
        "std::simd",
        "target_feature",
        "global_allocator"
      ],
      "file_globs": [
        "**/benches/**"
      ],
      "gate_tags": [
        "benchmark",
        "performance"
      ],
      "hints": [
        "performance",
        "latency",
        "throughput",
        "memory",
        "allocation",
        "benchmark",
        "hot-path"
      ],
      "id": "performance",
      "select": [
        "rust-evidence-reproducer"
      ]
    },
    {
      "change_classes": [
        "architecture",
        "interface",
        "schema",
        "migration",
        "persistence"
      ],
      "content_regex": [],
      "file_globs": [],
      "gate_tags": [
        "implementation-structure",
        "structure-review"
      ],
      "hints": [
        "implementation-structure",
        "public-type",
        "state-owner",
        "ownership-change",
        "module-topology",
        "multi-crate",
        "hard-to-reverse-topology"
      ],
      "id": "implementation-structure",
      "select": [
        "rust-implementation-structure"
      ]
    },
    {
      "change_classes": [
        "planning",
        "integration",
        "verification"
      ],
      "content_regex": [],
      "file_globs": [],
      "gate_tags": [
        "execution-slicing",
        "slice-touchpoint"
      ],
      "hints": [
        "execution-slicing",
        "execution-slice",
        "touchpoint",
        "vertical-slice",
        "foundation-exception"
      ],
      "id": "execution-slicing",
      "select": [
        "rust-execution-slicing"
      ]
    }
  ]
}
