{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bbk.local/schemas/bbk-rust-preflight-v1.schema.json",
  "title": "BBK Rust preflight",
  "type": "object",
  "required": ["schema", "root", "cargo", "workspace", "toolchain", "configuration", "digest"],
  "properties": {
    "schema": {"const": "bbk.rust-preflight.v1"},
    "root": {"type": "string"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
