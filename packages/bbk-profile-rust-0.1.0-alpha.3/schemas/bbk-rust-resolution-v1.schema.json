{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bbk.local/schemas/bbk-rust-resolution-v1.schema.json",
  "title": "BBK Rust profile resolution",
  "type": "object",
  "required": ["schema", "profile", "inputs", "observations", "selected_components", "gate_plan", "lock", "effective_sha256"],
  "properties": {
    "schema": {"const": "bbk.rust-profile-resolution.v1"},
    "effective_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
